generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id              String          @id @default(cuid())
  studentId       String          @unique // e.g. SMS-2025-0001
  fullName        String
  email           String          @unique
  dateOfBirth     DateTime
  programme       String
  academicYear    String
  enrolmentStatus EnrolmentStatus @default(ENROLLED)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  fees        Fee[]
  submissions Submission[]
  marks       Mark[]
}

enum EnrolmentStatus {
  ENROLLED
  DEFERRED
  WITHDRAWN
  COMPLETED
}

model Fee {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  amount      Float
  paidAmount  Float    @default(0)
  outstanding Float    @default(0) // computed after payments
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments Payment[]
}

model Payment {
  id          String   @id @default(cuid())
  feeId       String
  fee         Fee      @relation(fields: [feeId], references: [id])
  amount      Float
  paymentDate DateTime @default(now())
  reference   String   @unique
}

model Assessment {
  id        String   @id @default(cuid())
  title     String
  module    String
  deadline  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions Submission[]
  marks       Mark[]
}

model Submission {
  id             String     @id @default(cuid())
  studentId      String
  student        Student    @relation(fields: [studentId], references: [id])
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id])
  fileUrl        String // path or URL to uploaded file
  submittedAt    DateTime   @default(now())
  isLate         Boolean    @default(false)
  isResubmission Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  marks  Mark?   @relation(fields: [markId], references: [id]) // optional one-to-one (or one-to-many if multiple)
  markId String?
}

model Mark {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  assessmentId   String
  assessment     Assessment   @relation(fields: [assessmentId], references: [id])
  grade          Float? // 0-100, null if not entered
  classification String? // Pass, Merit, Distinction, or null
  isPublished    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  submissions    Submission[]

  @@unique([studentId, assessmentId]) // one mark per student per assessment
}
